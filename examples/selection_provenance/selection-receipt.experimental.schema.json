{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freshctx.com/schemas/selection-receipt.experimental.schema.json",
  "title": "Experimental FreshCtx SelectionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selectionMode",
    "request",
    "candidateSources",
    "inspectedSources",
    "selectedSource",
    "selectionReason",
    "observationId",
    "sourceCorrectness",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": "freshctx.selection_receipt.experimental.v1"},
    "selectionMode": {"enum": ["exact_filename", "discovery"]},
    "request": {"type": "string", "minLength": 1},
    "candidateSources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "inspectedSources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "selectedSource": {"type": "string", "minLength": 1},
    "selectionReason": {"type": "string", "minLength": 1},
    "observationId": {"type": "string", "minLength": 1},
    "sourceCorrectness": {"const": "NOT_ASSESSED"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
