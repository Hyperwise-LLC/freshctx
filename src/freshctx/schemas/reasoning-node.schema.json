{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freshctx.dev/schemas/v0.1/reasoning-node.schema.json",
  "title": "ReasoningNode",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "created_at", "kind", "dependencies", "digest", "metadata"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "kind": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "digest": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  }
}
